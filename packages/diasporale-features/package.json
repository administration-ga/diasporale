{
  "name": "@diasporale/features",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Surfaces propres à DIASPORALE : étiquette pays (CountryTag/ScopeTag), CountrySwitch, badges de confiance, cartes C1–C17 des specs design, ModerationBanner, états vides génératifs, bannière de statut d'adhésion, onboarding ; interface de données (fournisseur factice de démonstration tant que le moteur n'est pas câblé) ; i18n (espace de noms « diasporale ») ; charte en jetons [data-charte=\"diasporale\"].",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./i18n/client": "./src/i18n/client.tsx",
    "./data": "./src/data/index.ts",
    "./demo": "./src/demo/index.ts",
    "./styles/*.css": "./src/styles/*.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@antia/api": "workspace:*",
    "@antia/social-features": "workspace:*",
    "@antia/ui": "workspace:*",
    "@diasporale/domain": "workspace:*",
    "@fontsource-variable/ibm-plex-sans": "catalog:",
    "@fontsource/ibm-plex-mono": "catalog:",
    "@fontsource/ibm-plex-sans-condensed": "catalog:",
    "@hookform/resolvers": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "i18next": "catalog:",
    "lucide-react": "catalog:",
    "radix-ui": "catalog:",
    "react-hook-form": "catalog:",
    "react-i18next": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@antia/eslint-config": "workspace:*",
    "@antia/tsconfig": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
