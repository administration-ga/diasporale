{
  "name": "diasporale-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "description": "Installation PROVISOIRE de DIASPORALE tant que le moteur ANTIA n'est pas câblé (avant PD0). Au câblage, l'installation unique passe dans ../ANTIA et ce fichier ne sert plus qu'à documenter les commandes locales.",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "next": "16.2.9",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "typescript": "6.0.3",
      "tailwindcss": "^4",
      "@tailwindcss/postcss": "^4",
      "vitest": "^4.1.10",
      "jsdom": "^29.1.1",
      "@testing-library/react": "^16.3.2",
      "@testing-library/dom": "^10.4.1",
      "@testing-library/jest-dom": "^6.9.1",
      "zod": "^3.25.76",
      "react-hook-form": "^7.79.0",
      "@hookform/resolvers": "^5.2.2",
      "lucide-react": "^1.20.0",
      "sonner": "^2.0.7",
      "next-themes": "^0.4.6",
      "i18next": "^26.3.1",
      "react-i18next": "^16.5.0"
    }
  },
  "scripts": {
    "test:domain": "bun run --cwd packages/diasporale-domain test",
    "test": "bun run test:domain",
    "typecheck": "bun run --cwd packages/diasporale-domain typecheck",
    "verify": "bun run typecheck && bun run test"
  }
}
