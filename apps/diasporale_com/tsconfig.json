{
  "extends": "@antsia/tsconfig/nextjs.json",
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./src/*"],
      "@convex/*": ["../../../ANTSIA/convex/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.mts", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
